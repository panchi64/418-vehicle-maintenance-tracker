      "comment": "Gas widget, VoiceOver: nothing current",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gas nearby: no recent reports."
          }
        }
      }
    },
    "La gasolina más barata cerca de ti, o dónde hay en una emergencia.": {
      "comment": "Gas widget description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cheapest gas near you, or where there's gas in an emergency."
          }
        }
      }
    },
