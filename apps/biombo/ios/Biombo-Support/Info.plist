<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys the build settings can't express; Xcode merges the rest (GENERATE_INFOPLIST_FILE).
	     "Abrir en…" offers Google Maps and Waze only when installed (MapsApp.probeURL). -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>waze</string>
	</array>
</dict>
</plist>
