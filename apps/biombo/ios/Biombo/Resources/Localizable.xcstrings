{
  "sourceLanguage": "es",
  "strings": {
    "%@": {
      "comment": "A regular-grade price shown alone, e.g. '$0.99'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ %@": {
      "comment": "A price with its grade, e.g. '$1.12 premium'\nPrice ladder: DACO's reference label, then its price",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ %@–%@": {
      "comment": "Price ladder: DACO's range label, then its low and high prices",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@–%3$@"
          }
        }
      }
    },
    "%@ (estimado)": {
      "comment": "Restore bar end: the official estimate, labelled as an estimate",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (estimated)"
          }
        }
      }
    },
    "%@ a %@": {
      "comment": "A graded price, e.g. 'Regular a $1.03/L'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ at %2$@"
          }
        }
      }
    },
    "%@ avisó %@ después del primer vecino.": {
      "comment": "Outage timeline headline: how long after the first neighbour the agency spoke",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ posted %2$@ after the first neighbor."
          }
        }
      }
    },
    "%@ dice que partes de %@ están sin %@ desde las %@.": {
      "comment": "Siri: an agency says parts of a municipio are without a service since a clock time",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ says parts of %2$@ have had no %3$@ since %4$@."
          }
        }
      }
    },
    "%@ el galón de %@": {
      "comment": "VoiceOver: a price per gallon of a grade",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a gallon of %2$@"
          }
        }
      }
    },
    "%@ el litro de %@": {
      "comment": "VoiceOver: a price per litre of a grade",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a liter of %2$@"
          }
        }
      }
    },
    "%@ el litro, como lo marca la bomba": {
      "comment": "Under a price in gallons: the per-litre price pumps in Puerto Rico show",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per liter, as the pump shows it"
          }
        }
      }
    },
    "%@ en %@": {
      "comment": "Generic event: an answer word, then the place it applies to",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in %@"
          }
        }
      }
    },
    "%@ en %@, a %@.": {
      "comment": "Gas widget, VoiceOver in crisis: the status, the station, how far",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ at %2$@, %3$@ away."
          }
        }
      }
    },
    "%@ estima que vuelve %@.": {
      "comment": "Restore headline: the agency's estimate as a window, e.g. 'LUMA estima que vuelve mañana en la tarde.'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ estimates it's back %2$@."
          }
        }
      }
    },
    "%@ está en el plan de interrupciones de agua": {
      "comment": "Outage row: the named area is in the water-interruption plan",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is in the water-interruption plan"
          }
        }
      }
    },
    "%@ hasta las %@": {
      "comment": "Owner answer with its stated end, e.g. 'Con planta hasta las 8:00 p. m.'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ until %2$@"
          }
        }
      }
    },
    "%@ lo confirma": {
      "comment": "Barrio source: the agency confirms the outage there",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ confirms it"
          }
        }
      }
    },
    "%@ no tiene señal en %@": {
      "comment": "Outage row: a carrier has no signal in the named area",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ has no signal in %2$@"
          }
        }
      }
    },
    "%@ sigue sin agua": {
      "comment": "Outage row: the named area is still without water",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ still has no water"
          }
        }
      }
    },
    "%@ sigue sin agua desde el %@": {
      "comment": "Answer: the area has had no water since a weekday",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has had no water since %@"
          }
        }
      }
    },
    "%@ sigue sin agua desde las %@": {
      "comment": "Answer: the area has had no water since a clock time today",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has had no water since %@"
          }
        }
      }
    },
    "%@ sigue sin luz": {
      "comment": "Outage row: the named area is still without power",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ still has no power"
          }
        }
      }
    },
    "%@ sigue sin luz desde el %@": {
      "comment": "Answer: the area has had no power since a weekday",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has had no power since %@"
          }
        }
      }
    },
    "%@ sigue sin luz desde las %@": {
      "comment": "Answer: the area has had no power since a clock time today",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has had no power since %@"
          }
        }
      }
    },
    "%@ sigue sin señal": {
      "comment": "Outage row: the named area is still without signal",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ still has no signal"
          }
        }
      }
    },
    "%@ y alrededores": {
      "comment": "The area the home answer covers, e.g. 'Guaynabo y alrededores'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ and around"
          }
        }
      }
    },
    "%@ ya reporta sin %@ en partes de %@ desde las %@.": {
      "comment": "After a voice report: the agency already reports the outage there, since a clock time",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ already reports no %2$@ in parts of %3$@ since %4$@."
          }
        }
      }
    },
    "%@ · %@": {
      "comment": "A row's secondary line: the distance, then the trust atom\nDetail postcard: municipio, then distance\nMap tag on an official outage area: the agency, then the status, e.g. 'LUMA · Sin luz'\nQueued report: where, then the capture time",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@ a %@": {
      "comment": "An event's day, then its start and end times",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ to %3$@"
          }
        }
      }
    },
    "%@ · %lld kW": {
      "comment": "A charger port: connector standard, then its power",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$lld kW"
          }
        }
      }
    },
    "%@ · a %@": {
      "comment": "Quick Report context: municipio, then how far the place is",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · a %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ away"
          }
        }
      }
    },
    "%@, %@": {
      "comment": "Owner header: the place's barrio, then its municipio\nVoiceOver: a place, then its municipio\nWatched place: barrio, then municipio",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@ · %@": {
      "comment": "Detail postcard: barrio, municipio, then distance",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ · %3$@"
          }
        }
      }
    },
    "%@, %@: %@, publicada el %@": {
      "comment": "DACO's reference for a brand and grade, then when it was published",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@: %3$@, published %4$@"
