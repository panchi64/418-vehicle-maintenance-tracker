{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "paths": {
      "@checkpoint/*": ["../../apps/checkpoint/ios/checkpoint/*"],
      "@designkit/*": ["../../packages/DesignKit/Sources/DesignKit/Resources/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
