    },
    "%@. Solo según vecinos, fuera del área oficial.": {
      "comment": "VoiceOver for the neighbours-only part past an official outage area",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Neighbors only, outside the official area."
