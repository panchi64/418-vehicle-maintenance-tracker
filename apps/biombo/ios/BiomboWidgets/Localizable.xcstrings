{
  "sourceLanguage": "es",
  "strings": {
    "%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ · %@": {
      "comment": "Inline gas widget: the price per unit, then the station",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "Abre Biombo en Reportar, donde estás.": {
      "comment": "Control description: open Quick Report",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Biombo on Report, where you are."
          }
        }
      }
    },
    "Abre Biombo para reportar donde estás o ver los lugares que vigilas.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Biombo to report where you are or see the places you watch."
          }
        }
      }
    },
    "Abrir en Biombo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Biombo"
          }
        }
      }
    },
    "Actualizado %@": {
      "comment": "Widget: when the answer was last said, a clock time",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updated %@"
          }
        }
      }
    },
    "Avisa que no hay luz donde estás, con Deshacer.": {
      "comment": "Control description: report no power, with undo",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports no power where you are, with Undo."
          }
        }
      }
    },
    "Avisa que volvió la luz donde estás, con Deshacer.": {
      "comment": "Control description: report power back, with undo",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports the power is back where you are, with Undo."
          }
        }
      }
    },
    "Casa de Mamá": {
      "comment": "Widget gallery example: a watched place's name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mom's house"
          }
        }
      }
    },
    "Escoge cuál de tus lugares vigilados muestra el widget.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which of your watched places the widget shows."
          }
        }
      }
    },
    "Gasolina cerca": {
      "comment": "Gas widget name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gas nearby"
          }
        }
      }
    },
